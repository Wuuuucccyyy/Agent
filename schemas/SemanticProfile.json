        }
      },
      "required": [
        "category",
        "statement",
        "evidence"
      ],
      "title": "ApplicabilityClaim",
      "type": "object"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "properties": {
        "section": {
          "title": "Section",
          "type": "string"
        },
        "quote": {
          "maxLength": 400,
          "minLength": 8,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "section",
        "quote"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
