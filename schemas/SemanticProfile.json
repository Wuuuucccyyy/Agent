      "minItems": 3,
      "title": "Claims",
      "type": "array"
    },
    "unknowns": {
      "items": {
        "type": "string"
      },
      "maxItems": 10,
      "minItems": 1,
      "title": "Unknowns",
      "type": "array"
    }
  },
  "required": [
    "task_types",
    "suitability_text",
    "claims",
    "unknowns"
