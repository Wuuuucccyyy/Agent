{
  "$defs": {
    "ConditionRule": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "pattern": "^[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "severity": {
          "default": "hard",
          "enum": [
            "hard",
            "advisory"
          ],
          "title": "Severity",
          "type": "string"
        },
        "origin": {
          "enum": [
            "official_document",
            "derived",
            "input_contract"
          ],
          "title": "Origin",
          "type": "string"
        },
        "derivation": {
          "default": "",
          "maxLength": 1000,
          "title": "Derivation",
          "type": "string"
        },
        "when": {
          "items": {
            "$ref": "#/$defs/Predicate"
          },
          "maxItems": 8,
          "title": "When",
          "type": "array"
        },
        "conditions": {
          "items": {
            "$ref": "#/$defs/Predicate"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Conditions",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "description",
        "origin",
        "conditions",
        "evidence"
      ],
      "title": "ConditionRule",
      "type": "object"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "properties": {
        "section": {
          "title": "Section",
          "type": "string"
        },
        "quote": {
          "maxLength": 400,
          "minLength": 8,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "section",
        "quote"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "Parameters": {
      "additionalProperties": false,
      "properties": {
        "input_kind": {
          "default": "observations",
          "enum": [
            "observations",
            "dissimilarity",
            "dissimilarity_condensed",
            "correlation",
            "covariance"
          ],
          "title": "Input Kind",
          "type": "string"
        },
        "k": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "K"
        },
        "nfactors": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nfactors"
        },
        "sampsize": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sampsize"
        },
        "metric": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric"
        },
        "method": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "na_action": {
          "anyOf": [
            {
              "enum": [
                "fail",
                "omit",
                "unspecified"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Na Action"
        }
      },
      "title": "Parameters",
      "type": "object"
    },
    "Predicate": {
      "additionalProperties": false,
      "properties": {
        "fact": {
          "enum": [
            "task.type",
            "input.kind",
            "data.n",
            "features.count",
            "features.numeric",
            "features.numeric_or_boolean",
            "features.missing",
            "features.nonfinite",
            "features.pairwise_overlap",
            "groups.provided",
            "groups.count",
            "groups.min_size",
            "groups.no_missing",
            "groups.full_rank",
            "groups.within_variance_nonzero",
            "response.provided",
            "response.numeric",
            "response.missing",
            "matrix.square",
            "matrix.symmetric",
            "matrix.diagonal_zero",
            "matrix.diagonal_one",
            "matrix.nonnegative",
            "matrix.correlation_bounds",
            "matrix.condensed_valid",
            "param.k",
            "param.nfactors",
            "param.sampsize",
            "param.metric",
            "param.method",
            "param.na_action",
            "processing.complete"
          ],
          "title": "Fact",
          "type": "string"
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "lt",
            "le",
            "gt",
            "ge",
            "in"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "other_fact": {
          "anyOf": [
            {
              "enum": [
                "task.type",
                "input.kind",
                "data.n",
                "features.count",
                "features.numeric",
                "features.numeric_or_boolean",
                "features.missing",
                "features.nonfinite",
                "features.pairwise_overlap",
                "groups.provided",
                "groups.count",
                "groups.min_size",
                "groups.no_missing",
                "groups.full_rank",
                "groups.within_variance_nonzero",
                "response.provided",
                "response.numeric",
                "response.missing",
                "matrix.square",
                "matrix.symmetric",
                "matrix.diagonal_zero",
                "matrix.diagonal_one",
                "matrix.nonnegative",
                "matrix.correlation_bounds",
                "matrix.condensed_valid",
                "param.k",
                "param.nfactors",
                "param.sampsize",
                "param.metric",
                "param.method",
                "param.na_action",
                "processing.complete"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Other Fact"
        }
      },
      "required": [
        "fact",
        "op"
      ],
      "title": "Predicate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "function_id": {
      "title": "Function Id",
      "type": "string"
    },
    "source_rd_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Rd Sha256",
      "type": "string"
    },
    "semantic_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Semantic Sha256",
      "type": "string"
    },
    "defaults": {
      "$ref": "#/$defs/Parameters"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/ConditionRule"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Rules",
      "type": "array"
    },
    "coverage_notes": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Coverage Notes",
      "type": "array"
    }
  },
  "required": [
    "function_id",
    "source_rd_sha256",
    "semantic_sha256",
    "rules",
    "coverage_notes"
  ],
  "title": "RuleSet",
  "type": "object"
}
