    "id": "stats::prcomp",
    "package": "stats",
    "function_name": "prcomp",
    "task_types": [
      "pca"
    ],
    "summary": "prcomp performs principal components analysis on a numeric or complex data matrix via singular value decomposition of the centered (and optionally scaled) data, returning an object of class prcomp with standard deviations, loadings, and optionally rotated data.",
    "input_types": [
      "numeric matrix",
      "complex matrix",
      "data frame",
      "formula (no response variable)"
    ],
    "input_constraints": [
      "formula must have no response variable and refer only to numeric variables",
      "scale = TRUE cannot be used with zero or constant variables (for center = TRUE)",
      "newdata must match column names or column count/order of original fit"
    ],
    "output_types": [
      "sdev (standard deviations of principal components)",
      "rotation (matrix of variable loadings/eigenvectors)",
      "x (rotated data, if retx = TRUE)",
      "center and scale values used"
    ],
    "assumptions": [
      "Computation uses singular value decomposition of the data matrix, not eigen on the covariance matrix",
      "Variances use divisor N - 1",
      "Signs of rotation columns are arbitrary"
    ],
    "missing_data_handling": "Controlled by na.action; default from options, na.fail if unset, factory-fresh default na.omit. Formula method applies napredict to omitted values.",
    "failure_conditions": [
      "scale = TRUE with zero or constant variables (center = TRUE)",
      "newdata columns do not match original fit names or count/order"
    ],
    "alternatives": [
      "princomp (uses eigen on covariance matrix)",
      "svd",
      "eigen"
    ],
